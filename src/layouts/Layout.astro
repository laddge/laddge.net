---
import '@/styles/global.css'
import ThemeSwitch from '@/components/ui/ThemeSwitch.astro'
import LaddgePng from '@/assets/images/laddge.min.png'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const { title, description = '', ogImage } = Astro.props
const baseTitle = 'Laddgeのページ'
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" type="image/png" href="/apple-touch-icon-180x180.png" />
		<meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title ? `${title} | ${baseTitle}` : baseTitle} />
    <meta property="og:description" content={description}/>
    {ogImage ? <>
      <meta property="og:image" content={(new URL(ogImage, Astro.site)).href} />
      <meta name="twitter:card" content="summary_large_image" />
    </> : <>
      <meta property="og:image" content="https://github.com/laddge.png" />
      <meta name="twitter:card" content="summary" />
    </>}
		<meta name="twitter:site" content="@laddge_" />
		<title>{title ? `${title} | ${baseTitle}` : baseTitle}</title>
    <script is:inline>(k=>(v=>v&&(document.documentElement.dataset[k]=v))(localStorage.getItem(k)))('theme')</script>
	</head>
	<body class="flex flex-col">
    <header class="p-2 bg-base-100/80 backdrop-blur sticky top-0 z-50 w-full flex justify-between items-center">
      <a href="/" class="btn btn-ghost text-xl font-bold flex items-center w-fit p-1 h-auto">
        <img src={LaddgePng.src} alt="Laddge" class="h-8 w-8 rounded-full" />
        <h1 class="mx-1">{baseTitle}</h1>
      </a>
      <ThemeSwitch />
    </header>
    <main class="grow p-4 container mx-auto">
      <slot />
    </main>
    <footer class="text-sm text-center p-4">
      &copy; 2026 Laddge
    </footer>
	</body>
</html>

<style is:global>
  body {
    min-height: 100vh;
    min-height: 100dvh;
  }
</style>
