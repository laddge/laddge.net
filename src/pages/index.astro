---
import Layout from '../layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import LaddgePng from '../assets/images/laddge.min.png'
---

<Layout title="" description="ものづくり学生の個人サイト">
  <div class="grid md:grid-cols-3 gap-4">
    <div class="card bg-base-200 border-2 border-base-300 outline-2 outline-base-300 -outline-offset-8 outline-dashed transition-none">
      <div class="card-body">
        <img src={LaddgePng} alt="Laddge" class="w-32 h-32 mx-auto" style="image-rendering: pixelated;" />
        <ul class="mt-2 list-disc leading-6 pl-4">
          <li>
            名前
            <ul class="pl-4 pb-2">
              <li>Laddge (らっじ) /<br />髙橋 朋希 (Takahashi Tomoki)</li>
            </ul>
          </li>
          <li>
            誕生日
            <ul class="pl-4 pb-2">
              <li>2004-06-28</li>
            </ul>
          </li>
          <li>
            出身地
            <ul class="pl-4 pb-2">
              <li>長野</li>
            </ul>
          </li>
          <li>
            所属
            <ul class="list-disc pl-4 pb-2">
              <li>調布にある国立大学</li>
              <li><a href="//ueckoken.club" target="_blank" class="underline">工学研究部</a></li>
              <li><a href="//vll.jp" target="_blank" class="underline">バーチャルライブ研究会</a></li>
            </ul>
          </li>
          <li>
            趣味
            <ul class="pl-4 pb-2">
              <li>web開発 / 電子工作 / 3Dプリンター / 自転車 / スキー / 睡眠</li>
            </ul>
          </li>
        </ul>
        <div class="grid grid-cols-3 gap-2 mt-2">
          <a href="//twitter.com/laddge_" target="_blank" aria-label="twitter" class="btn btn-lg p-0 btn-ghost flex items-center"><Icon name="fa7-brands:twitter" size="32" /></a>
          <a href="//github.com/laddge" target="_blank" aria-label="github" class="btn btn-lg p-0 btn-ghost flex items-center"><Icon name="fa7-brands:github" size="32" /></a>
          <a href="//instagram.com/laddge_" target="_blank" aria-label="instagram" class="btn btn-lg p-0 btn-ghost flex items-center"><Icon name="fa7-brands:instagram" size="32" /></a>
        </div>
      </div>
    </div>
    <div class="md:col-span-2">
      <div class="card bg-base-200">
        <div class="card-body">
          <div class="flex flex-col items-center gap-2 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 1024 1024"><!-- Icon from WebHostingHub Glyphs by WebHostingHub - https://scripts.sil.org/cms/scripts/page.php?site_id=nrsi&id=OFL --><path fill="currentColor" d="M960 640V384h64v256zm-64-320h64v64h-64zm-64-64h-64v-64h-64v-64h128V64h128v128h-64v128h-64zM640 64h64v64h-64zm-64 128H384v-64h192zm64 64h-64v-64h64zm64 64h64v64h-64v64h-64v64h-64v64h-64v64h-64v64h-64v64h-64v64h-64v64h-64v128H0V832h128v-64h64v-64h64v-64h64v-64h64v-64h64v-64h64v-64h64v-64h64v-64h64zM128 896H64v64h64zm704-448h-64v-64h64zm64 192h-64V448h64zm64 64h-64v-64h64zM320 128V64h64v64zM384 0h256v64H384z"/></svg>
            工事中
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
